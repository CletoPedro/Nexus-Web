# Copy to .env for local development (uv run picks it up automatically)
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
CORS_ORIGINS=["http://localhost:3000","http://localhost:3311"]
LOG_LEVEL=INFO

# --- Auth (W12) ---
# SECRET_KEY: REQUIRED in any real deployment. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real value here or anywhere in the repo.
SECRET_KEY=replace-with-a-long-random-value-never-commit-the-real-one

# Bootstrap admin: only used by the one-time W12 migration data step.
# Leave unset to skip creating a bootstrap admin (existing rows will stay
# unowned until you assign them manually — see PHASE_W12_REPORT.md).
# Never a real password in this file or in version control.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
